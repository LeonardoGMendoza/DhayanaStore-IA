# Copie para .env e preencha com os MESMOS valores do VinaCare/Omni.
# NUNCA suba o .env para o GitHub.
OCI_USER=ocid1.user.oc1..
OCI_FINGERPRINT=aa:bb:cc:...
OCI_TENANCY=ocid1.tenancy.oc1..
OCI_REGION=sa-saopaulo-1
OCI_COMPARTMENT_ID=ocid1.compartment.oc1..
# A chave privada: use UMA das duas opcoes
OCI_KEY_B64=
OCI_KEY_CONTENT=
# Loja
DHAYANA_TIENDA=Dhayana Store
DHAYANA_CIUDAD=Trujillo
DHAYANA_MONEDA=S/
DHAYANA_ORIGENS=http://localhost:5173,http://127.0.0.1:5173,https://leonardogmendoza.github.io
# Painel de pedidos
# Senha do painel (header X-Admin-Token). Obrigatória antes de colocar no servidor.
DHAYANA_ADMIN_TOKEN=
DHAYANA_DATA_DIR=./data
DHAYANA_PAIS_TEL=51
# Link público de acompanhamento (o código do pedido vai no final)
DHAYANA_LINK_SEGUIMIENTO=
